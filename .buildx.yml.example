# Colcon Buildx Configuration Example (YAML format)
# Copy this file to your workspace root as .buildx.yml

# Cross-compilation method: sysroot or docker
method: docker

# Docker Method Configuration
docker_image: sapertuz/smrbx-buildx:kv26-jazzy
docker_platform: linux/arm64

# SSHFS Sysroot Method (alternative - uncomment to use)
# method: sysroot
# sysroot_host: kria-vision-home
# sysroot_mount: ~/mnt/kria-sysroot
# toolchain: toolchainfile.cmake
# no_mount: false

# Build directories
build_base: cross_build
install_base: cross_install

# Deployment
deploy: false
deploy_target: ubuntu@10.42.0.3:~/ros2_ws/install/

# Additional colcon arguments
# colcon_args:
#   - --packages-select
#   - my_package
#   - --cmake-args
#   - -DCMAKE_BUILD_TYPE=Release
