# Generated by colcon-buildx for @SOURCE_IMAGE@. Sourced before every build in this image. POSIX sh.

BUILDX_ENV_SETUP="@ENV_SETUP@"
export BUILDX_SYSROOT="@SYSROOT@"
export ROS_DISTRO="@ROS_DISTRO@"

if [ -n "$BUILDX_ENV_SETUP" ]; then
  # An OE/Yocto SDK: its own environment first.
  . "$BUILDX_ENV_SETUP"
  if [ -z "${OE_CMAKE_TOOLCHAIN_FILE:-}" ]; then
    # No ros-sdk-env in this SDK (meta-ros adds it for Jazzy only). Set what it would have set.
    # The ROS prefix lives in the target sysroot; its sh setup cannot find itself, so it is told.
    export OE_CMAKE_TOOLCHAIN_FILE="$OECORE_NATIVE_SYSROOT/usr/share/cmake/OEToolchainConfig.cmake"
    export PYTHON_SOABI="@PYTHON_SOABI@"
    export AMENT_PYTHON_EXECUTABLE="$OECORE_NATIVE_SYSROOT/usr/bin/python3"
    AMENT_CURRENT_PREFIX="$BUILDX_SYSROOT/opt/ros/$ROS_DISTRO" \
      . "$BUILDX_SYSROOT/opt/ros/$ROS_DISTRO/local_setup.sh"
    export PYTHONPATH="$BUILDX_SYSROOT/usr/lib/@PYTHON@/site-packages${PYTHONPATH:+:$PYTHONPATH}"
  fi
else
  # An image that runs as the target.
  . "/opt/ros/$ROS_DISTRO/setup.sh"
  # Yocto builds link with --as-needed (OE's default LDFLAGS). A dev container's plain gcc does not,
  # and rcutils' exported -latomic then makes every binary need libatomic.so.1, which the runtime
  # images do not ship.
  export LDFLAGS="${LDFLAGS:+$LDFLAGS }-Wl,--as-needed"
fi
