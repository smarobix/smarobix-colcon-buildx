# Colcon Buildx Configuration Example
# Copy this file to your workspace root as .buildx.conf

# Cross-compilation method: sysroot or docker
method = docker

# =============================================================================
# Docker Method Configuration
# =============================================================================
docker_image = sapertuz/smrbx-buildx:kv26-jazzy
docker_platform = linux/arm64

# =============================================================================
# SSHFS Sysroot Method Configuration (alternative to Docker)
# =============================================================================
# method = sysroot
# sysroot_host = kria-vision-home
# sysroot_mount = ~/mnt/kria-sysroot
# toolchain = toolchainfile.cmake
# no_mount = false

# =============================================================================
# Build Configuration
# =============================================================================
build_base = cross_build
install_base = cross_install

# =============================================================================
# Deployment Configuration
# =============================================================================
deploy = false
deploy_target = ubuntu@10.42.0.3:~/ros2_ws/install/

# =============================================================================
# Additional Colcon Arguments (optional)
# =============================================================================
# Pass extra arguments to colcon build
# colcon_args = --packages-select my_package --cmake-args -DCMAKE_BUILD_TYPE=Release
